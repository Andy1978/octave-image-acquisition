.PHONY: all clean distclean realclean

OCT := __imaq_handler__.oct
OBJ := cl_imaq_handler.o cl_v4l2_handler.o cl_mf_handler.o cl_img_win.o

MKOCTFILE  ?= mkoctfile
MKOCTFLAGS ?= -Wall -v

all: $(OBJ) $(OCT)

debug : MKOCTFLAGS += -ggdb -O0
debug : all

%.o: %.cc %.h
	$(MKOCTFILE) $(MKOCTFLAGS) -c $<

%.oct: %.cc $(OBJ)
	$(MKOCTFILE) $(MKOCTFLAGS) $^ @LIBS@ -o $@

clean:
	rm -f *.oct *.o
	rm -f octave-core octave-workspace

distclean: clean
	rm -f Makefile config.status config.log config.h

realclean: distclean
	rm -f configure config.h.in
	rm -rf autom4te.cache

